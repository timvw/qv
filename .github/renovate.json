{
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "groupName": "rust non-major",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "groupName": "datafusion ecosystem",
      "matchManagers": ["cargo"],
      "matchPackagePatterns": ["^datafusion", "^deltalake", "^object_store", "^iceberg", "^arrow", "^parquet"],
      "separateMajorMinor": false,
      "commitMessageTopic": "datafusion ecosystem dependencies"
    },
    {
      "matchPackagePatterns": [
        "*"
      ],
      "automerge": true
    },
    {
      "description": "iceberg-rust and datafusion-iceberg are pinned to git revs that must stay in sync (datafusion-iceberg pins iceberg-rust itself). Update them by hand until both publish releases.",
      "matchManagers": ["cargo"],
      "matchPackagePatterns": ["^iceberg"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    }
  ],
  "dependencyDashboard": true
}
